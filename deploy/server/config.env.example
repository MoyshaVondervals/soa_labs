# ~/soa-lab2/config.env on helios (deploy-helios.sh creates it on the first run; chmod 600).
export SOA_SERVER_HOST='helios.cs.ifmo.ru'
export SOA_DB_HOST='pg'
export SOA_DB_PORT='5432'
export SOA_DB_NAME='studs'
export SOA_DB_USER='s409361'
# Schema for the lab tables; defaults to SOA_DB_USER.
export SOA_DB_SCHEMA='s409361'
# No secrets here. Database password: matching line of ~/.pgpass. Other passwords: ~/soa-lab2/secrets.env,
# generated on the server by deploy/secrets.sh (chmod 600).
# Worker address for the HR 307 redirect (clients come through the SSH tunnel).
# export SOA_PUBLIC_WORKER_URL='https://localhost:18443'
